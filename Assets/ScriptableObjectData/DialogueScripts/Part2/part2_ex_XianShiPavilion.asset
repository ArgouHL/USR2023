  - CharacterName: XianShiPavilion
    Line: "\u5728\u7576\u6642\u5B78\u8005\u5728\u6B77\u53F2\u8003\u8B49\u7684\u89E3\u8B80\u4E0B\uFF0C\u88AB\u7576\u4F5C\u6210\u98A8\u795E\u5EDF\u7684\u9418\u6A13\u800C\u91CD\u5EFA"
