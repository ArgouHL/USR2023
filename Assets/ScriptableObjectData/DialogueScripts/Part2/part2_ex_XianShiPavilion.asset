  - CharacterName: XianShiPavilion
    Line: "\u5728\u65E5\u6CBB\u6642\u671F\u56E0\u5730\u9707\u5012\u4E0B\uFF0C\u4E26\u5728\u6C11\u570B\u516B\u3007\u5E74\u4EE3\u91CD\u4FEE\u98A8\u795E\u5EDF\u8207\u63A5\u5B98\u4EAD\u904E\u7A0B\u4E2D\u91CD\u65B0\u51FA\u571F"
