  - CharacterName: XianShiPavilion
    Line: "\u7891\u4EAD\u4E0A\u523B\u6709\u300C\u5CF4\u77F3\u300D\u4E8C\u5B57\uFF0C\u8A34\u8AAA\u4E00\u5247\u767E\u59D3\u611F\u5FF5\u7236\u6BCD\u5B98\u7684\u6B77\u53F2\u6545\u4E8B\u3002"
