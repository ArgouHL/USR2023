    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: TangyinPavilion
    Line: "\u5728\u65E5\u6CBB\u6642\u671F\u56E0\u5730\u9707\u7834\u640D\uFF0C\u96F6\u4EF6\u88AB\u653E\u5728\u5357\u9580\u57CE\u9644\u8FD1\u6216\u88AB\u57CB\u5165\u5730\u4E0B"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: TangyinPavilion
    Line: "\u5728\u6C11\u570B\u516B\u3007\u5E74\u4EE3\u91CD\u4FEE\u98A8\u795E\u5EDF\u8207\u63A5\u5B98\u4EAD\u904E\u7A0B\u4E2D\u800C\u91CD\u65B0\u51FA\u571F"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: TangyinPavilion
    Line: "\u5728\u7576\u6642\u6C92\u6709\u4F7F\u7528\u539F\u96F6\u4EF6\u4FEE\u5FA9\uFF0C\u800C\u662F\u88AB\u7576\u4F5C\u6210\u98A8\u795E\u5EDF\u7684\u9F13\u6A13\uFF0C\u4EFF\u7167\u4E00\u65C1\u7AF9\u65F3\u5CF4\u77F3\u4EAD\uFF08\u7576\u6642\u7684\u9418\u6A13\uFF09\u800C\u91CD\u5EFA"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: TangyinPavilion
    Line: "\u5F8C\u4F86\u57282016\u5E74\u7684\u9AD8\u96C4\u7F8E\u6FC3\u5730\u9707\u6BC0\u640D\uFF0C\u5728\u8003\u53E4\u8003\u64DA\u5F8C\uFF0C\u5F97\u77E5\u5176\u539F\u5148\u7684\u6B77\u53F2\u9762\u8C8C\u5F8C\u518D\u6B21\u91CD\u5EFA"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: TangyinPavilion
    Line: "\u7891\u4EAD\u4E0A\u523B\u6709\u300C\u68E0\u852D\u300D\u4E8C\u5B57\uFF0C\u8A34\u8AAA\u4E00\u5247\u767E\u59D3\u611F\u5FF5\u7236\u6BCD\u5B98\u7684\u6B77\u53F2\u6545\u4E8B\u3002"
