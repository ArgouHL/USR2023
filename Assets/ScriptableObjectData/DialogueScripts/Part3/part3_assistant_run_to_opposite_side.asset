  - CharacterName: mascot_opening
    Line: "\u7576\u6642\u8239\u5BB6\u6703\u628A\u8CA8\u7269\u653E\u5728\u6CB3\u5176\u4E2D\u4E00\u908A\u7684\u5E97\u8216\u5F8C\u65B9"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: Idle
  - CharacterName: mascot_opening
    Line: "\u4E0D\u540C\u7684\u6E2F\u9053\u80FD\u65B9\u7684\u5CB8\u908A\u4E5F\u6709\u5206\u5DE6\u53F3\uFF0C\u6216\u5169\u908A\u90FD\u662F\u5E97\u8216\u5F8C\u65B9"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: mascot_opening
    Line: "\u4F46\u5728\u7576\u6642\u5F88\u591A\u751F\u6D3B\u8271\u82E6\uFF0C\u53EA\u80FD\u56DB\u8655\u6D41\u6D6A\u7684\u7F85\u6F22\u8173\uFF0C\u6C92\u4EBA\u53D6\u8D70\u7684\u8CA8\u7269\u6703\u6709\u6A5F\u6703\u88AB\u7F85\u6F22\u8173\u62FF\u8D70"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: mascot_opening
    Line: "\u70BA\u89E3\u6C7A\u7F85\u6F22\u8173\u548C\u5176\u4ED6\u6CBB\u5B89\u554F\u984C\uFF0C\u7576\u5730\u5546\u4EBA\u548C\u5C45\u6C11\u7D44\u7E54\u8D77\u4F86\uFF0C\u9032\u884C\u591C\u9593\u5DE1\u908F\u7B49\u884C\u52D5"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: mascot_opening
    Line: "\u5F8C\u4F86\u6F38\u6F38\u8B8A\u6210\u806F\u5883\u7D44\u7E54\uFF0C\u6210\u70BA\u7531\u90CA\u5546\u9818\u5C0E\uFF0C\u6C11\u9593\u81EA\u767C\u7D44\u6210\u7684\u9632\u885B\u7D44\u7E54"
    WaitDurationAfterLine: 1
    AnimationClipName: 
    IsWaitUntilAnimationEnd: 0
    SubAnimationClipName: 
  - CharacterName: mascot_opening
    Line: "(\u53EF\u4EE5\u9000\u51FA\u6642\u7A7A\u9580\u6216\u7E7C\u7E8C\u89C0\u5BDF)"
